APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tailadmin_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=119.59.104.20
MAIL_PORT=587
MAIL_USERNAME=no-reply@clickclasstutor.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@clickclasstutor.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="no-reply@clickclasstutor.com"
# Must match the TLS certificate name of the SMTP server (currently ns27.hostinglotus.net).
MAIL_SMTP_PEER_NAME=ns27.hostinglotus.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (course thumbnails + videos)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_URL=https://YOUR_PUBLIC_R2_OR_CDN_DOMAIN
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false

# วิดีโออัปโหลดตรงจากเบราว์เซอร์ขึ้น R2 (ต้องตั้ง CORS ของ bucket ดู docs/media-storage.md)
MEDIA_VIDEO_MAX_MB=5120
MEDIA_VIDEO_PART_MB=32
MEDIA_VIDEO_UPLOAD_TTL_HOURS=24

VITE_APP_NAME="${APP_NAME}"

# Nuxt storefront allowed to call /api/v1. Use * for any origin, or a comma-separated list.
FRONTEND_URL=http://localhost:3000

# Single Nuxt origin used in the email confirmation link redirect. Falls back to the first FRONTEND_URL.
STUDENT_APP_URL=http://localhost:3000

# Required on every /api/v1 request as the X-Api-Key header.
STOREFRONT_API_KEY=

# Online payment (see docs/payments.md). fake = test mode without real gateway calls.
# Per-method drivers fall back to PAYMENT_DRIVER.
PAYMENT_DRIVER=fake
# PAYMENT_THAI_QR_DRIVER=fake
# PAYMENT_CARD_DRIVER=live
PAYMENT_MERCHANT_NAME="Click Class Tutor"
PAYMENT_THAI_QR_ENABLED=true
PAYMENT_CARD_ENABLED=true
PAYMENT_LINK_TTL_MINUTES=60
PAYMENT_RETURN_URL=

KGP_BASE_URL=https://openapi-uat.kgppayments.com
KGP_SECRET_KEY=
KGP_PUBLIC_KEY=
KGP_QR_EXPIRE_SECONDS=600

OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Receipt PDF header (see docs/receipts.md)
RECEIPT_COMPANY_NAME="Click Class Tutor"
RECEIPT_COMPANY_ADDRESS=
RECEIPT_TAX_ID=
RECEIPT_PHONE=
RECEIPT_EMAIL=
RECEIPT_LOGO=images/logo/logo.png
RECEIPT_TIMEZONE=Asia/Bangkok
